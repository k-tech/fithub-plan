# Local development. DEV_MODE permits the untrusted account picker only on loopback.
FITHUB_DEV_MODE=1
FITHUB_LISTEN=127.0.0.1:8080
FITHUB_PUBLIC_URL=http://127.0.0.1:8080
FITHUB_APP_URL=http://127.0.0.1:5173
FITHUB_DATABASE_URL=postgres://fithub:fithub-dev-only@127.0.0.1:55439/fithub?sslmode=disable
FITHUB_GIT_ROOT=./data/repos
FITHUB_DEV_ADMIN_EMAIL=admin@fithub.local

# Optional Google sign-in, including in local development. Register this exact
# redirect URI for a Google OAuth web application:
# http://127.0.0.1:8080/api/v1/auth/google/callback
# FITHUB_GOOGLE_CLIENT_ID=...
# FITHUB_GOOGLE_CLIENT_SECRET=...
# FITHUB_GOOGLE_HOSTED_DOMAIN=example.com

# Only set after installing and verifying the OpenSSH gateway. The URL is
# shown for each repository and uses the ssh://git@host/team/repo.git form.
# FITHUB_SSH_BASE_URL=ssh://git@127.0.0.1:2222

# Optional receive hook. Build `go build -o fithub-hook ./cmd/fithub-hook`,
# install it at a root-owned absolute path, and point these variables at it and
# at a private 0600 JSON file containing {"databaseUrl":"postgres://..."}.
# Without these the hook enforces only the fixed ref-namespace rule.
# FITHUB_HOOK_BINARY=/usr/local/libexec/fithub-hook
# FITHUB_HOOK_CONFIG=/etc/fithub/hook.json
